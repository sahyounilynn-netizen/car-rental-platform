NODE_ENV=development
PORT=4000

# Matches docker-compose.yml postgres service
DATABASE_URL=postgresql://car_rental:car_rental@localhost:5432/car_rental

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Fill these in once you've created a Cloudinary account (needed starting Phase 5)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
